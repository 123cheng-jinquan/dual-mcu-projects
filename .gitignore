# ---- STM32 / CubeMX 生成物 ----
firmware-stm32/cubemx/Debug/
firmware-stm32/cubemx/Release/
firmware-stm32/cubemx/build/
firmware-stm32/cubemx/**/*.o
firmware-stm32/cubemx/**/*.d
