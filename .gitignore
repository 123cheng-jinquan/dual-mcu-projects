# ---- 本机专用的 npm 目录（为了绕开沙箱的 EPERM 才建在工作区里）----
# 生成中文字库用的 lv_font_conv 装在这里；**不该入库**：
# 它是本机环境产物，别人 clone 后自己 `npm install lv_font_conv` 即可。
.npm-cache/
.npm-global/
node_modules/

# ---- 编辑器 / 系统 ----
# 只忽略仓库根目录的 .vscode；firmware-stm32/cubemx/.vscode 是要版本化的调试配置
.vscode/*
.idea/
*.swp
Thumbs.db
desktop.ini
~$*

# ---- 长跑测试产物（几小时的原始日志，几十 MB）----
logs/

# ---- 网络受限环境的 SSH 变通（见 docs/09-git-remote-note.md）----
# 这台机器上 github.com:22 的 DNS 解析会被打断，只能用备用入口
# ssh://git@ssh.github.com:443/... ；本文件是它的主机密钥记录。
# 属于**本机环境产物**，不该入库。
.git_hostkeys
.git_ssh_config
.git_known_hosts

